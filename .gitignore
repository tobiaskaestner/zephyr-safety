# Ignore rules for the Zephyr safety documentation repository.

# Build output. The documented build directory is outside this repository
# (for example ../build/doc), but in-tree builds land here.
build*/
_build/
doc/_build/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# The affirmatrix case tree of a local evidence run
/case/

# Logs and patches
*.log
/*.patch

# Editors and local tool settings
*.swp
*.swo
*~
\#*\#
.vscode/
.idea/
.DS_Store
.claude/settings.local.json
