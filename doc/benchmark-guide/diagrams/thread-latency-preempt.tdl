# apps.rst, thread_latency (M3): sem, preempt mode (the default).
# Schematic: the box widths fit the labels, they are not durations.
include apps.tdc
diagram thread-latency-preempt "thread_latency, sem-preempt: the giver wakes a taker with a higher priority"
schematic
axis "time after the edge (schematic)" -20..760

giver pending -20.. "blocked in k_sem_take(isr_sem)"
taker pending -20.. "blocked in k_sem_take()"
idle sleep -20..0 "WFI"
@edge
hw 82 "pin, entry" : Edge, EXTI, NVIC, wake-up from WFI and exception entry.
dev 36 "now" : _isr_wrapper, then t_isr = stim_now().
@t_isr
dev 43 "give" : k_sem_give(&isr_sem) makes the giver ready. The ISR exit pends PendSV.
pendsv 56 "switch" : Idle thread to giver.
giver 36 "now" : t_thr = stim_now(), for isr2thr.
@t_thr
giver 36 "now" : t0 = stim_now(), just before the wake call.
@t0
giver 43 "give" : The wake call. It makes the taker ready. The taker has the higher priority, so the giver is preempted in the call.
pendsv 56 "switch" : Giver to taker.
taker 36 "now" : t1 = stim_now(), the first action after k_sem_take() returns.
@t1
taker 43 "take" : The taker counts the wake and blocks again.
@taker_blocks anchor
taker pending taker_blocks..760 "blocked"
pendsv 56 "switch" : Taker back to giver.
giver 36 "now" : t2 = stim_now(): the wake call has returned.
@t2
giver 76 "next edge" : The histograms t2t and t2t_ret, giver_prepare(), stim_arm(), then k_sem_take(&isr_sem) blocks.
@giver_blocks anchor
giver pending giver_blocks..760 "blocked"
pendsv 56 "switch" : Giver to the idle thread.
@idle_runs anchor
idle sleep idle_runs..760 "WFI"
span t_isr..t_thr "isr2thr" !
span t0..t1 "t2t" !
span t0..t2 "t2t_ret" !
