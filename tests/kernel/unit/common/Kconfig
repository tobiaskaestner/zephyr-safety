# Kconfig options of the kernel unit tests. A test application sources
# this file from its own Kconfig file, before Kconfig.zephyr.

config KERNEL_UNIT_USERSPACE
	bool "Build the unit with user mode support"
	select ARCH_HAS_USERSPACE
	select CPU_HAS_MPU
	help
	  The unit_testing architecture has no user mode support, so
	  CONFIG_USERSPACE cannot be enabled. This option tells Kconfig that
	  the architecture has user mode support and an MPU. Then a test
	  scenario can enable CONFIG_MPU and CONFIG_USERSPACE, and the unit
	  under test compiles with its user mode code (the z_vrfy_*
	  functions). No user thread runs.

# Second definition of the ztest option. The first one depends on
# COVERAGE_GCOV (target builds). On the unit_testing board,
# common/src/gcov_native.c is the gcov backend of the ztest rule. Thus
# twister --coverage-per-test works for the unit tests.
config ZTEST_COVERAGE_PER_TEST
	bool "Dump code coverage data per individual test"
	depends on COVERAGE_NATIVE_GCOV
	help
	  Reset the gcov counters before each test and write a separate,
	  test-tagged set of .gcda files after each test (named
	  "<gcda-path>@@<suite>.<test>").

config KERNEL_UNIT_TRACE
	bool "Write a trace of each test for the trace check"
	help
	  The fake group trace writes one line of JSON for each call of the
	  object API and for each call of the unit into the scheduler, the
	  lock and the poll events (common/include/kernel_unit_trace.h). The
	  lines start with "KTRACE ". The trace module of the object in
	  spec/tla/trace/ checks each trace against the contract module.
