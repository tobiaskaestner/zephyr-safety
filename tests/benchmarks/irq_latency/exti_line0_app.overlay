 *
 * Take EXTI line 0 (IRQ 6) away from the GPIO interrupt driver, so that
 * the app can connect its own ISR to it. Same as stm32g4.dtsi without
 * the "line0" entry.
 */

&exti {
	interrupts = <7 0>, <8 0>, <9 0>, <10 0>, <23 0>, <40 0>;
	interrupt-names = "line1", "line2-TSC", "line3", "line4",
			  "line5-9", "line10-15";
	line-ranges = <1 1>, <2 1>, <3 1>, <4 1>, <5 5>, <10 6>;
};
