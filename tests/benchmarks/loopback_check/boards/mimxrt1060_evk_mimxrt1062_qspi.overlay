 *
 * Loopback wire A3 (GPIO1_IO21, output) -> D2 (GPIO1_IO11, input). This
 * is the D2 - A3 wire of nucleo_g474re, but A3 drives, because only A3
 * has a timer compare output (GPT2_COMPARE1) on this board.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	zephyr,user {
		stim-gpios = <&arduino_header ARDUINO_HEADER_R3_A3 GPIO_ACTIVE_HIGH>;
		resp-gpios = <&arduino_header ARDUINO_HEADER_R3_D2 GPIO_ACTIVE_HIGH>;
	};
};
