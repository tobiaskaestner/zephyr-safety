 *
 * Loopback wire D2 (PA10) -> A3 (PB0, EXTI line 0). TIM2 channel 4 drives
 * PA10 (see common/include/latbench/stim.h). The app owns EXTI line 0, so
 * the GPIO interrupt driver gets all lines except line 0.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/gpio/arduino-header-r3.h>

/ {
	zephyr,user {
		resp-gpios = <&arduino_header ARDUINO_HEADER_R3_A3 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&tim2_ch4_pa10>;
		pinctrl-names = "default";
	};
};

&pwm2 {
	status = "disabled";
};

&exti {
	interrupts = <7 0>, <8 0>, <9 0>, <10 0>, <23 0>, <40 0>;
	interrupt-names = "line1", "line2-TSC", "line3", "line4",
			  "line5-9", "line10-15";
	line-ranges = <1 1>, <2 1>, <3 1>, <4 1>, <5 5>, <10 6>;
};
